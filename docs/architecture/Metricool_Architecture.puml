@startuml Metricool_Complete_Architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam classBackgroundColor #F0F0F0
skinparam classBorderColor #333
skinparam arrowColor #333

' ==================== ENUMERATIONS ====================
package "Enumerations (Kiểu dữ liệu)" #F5F5F5 {
    enum UserRole {
        OWNER
        ADMIN
        EDITOR
        VIEWER
        ANALYST
    }

    enum PlanType {
        FREE
        STARTER
        ADVANCED
        CUSTOM
    }

    enum BillingCycle {
        MONTHLY
        ANNUAL
    }

    enum PlatformType {
        INSTAGRAM
        FACEBOOK
        TIKTOK
        LINKEDIN
        TWITTER_X
        PINTEREST
        YOUTUBE
        TWITCH
        THREADS
        BLUESKY
        GOOGLE_BUSINESS
    }

    enum AdPlatformType {
        META_ADS
        GOOGLE_ADS
        TIKTOK_ADS
    }

    enum PostType {
        IMAGE
        VIDEO
        CAROUSEL
        REEL
        STORY
        SHORT
        THREAD
        PIN
        TIKTOK_CAROUSEL
    }

    enum PostStatus {
        DRAFT
        SCHEDULED
        PENDING_APPROVAL
        APPROVED
        PUBLISHED
        FAILED
    }

    enum CalendarView {
        DAY
        WEEK
        MONTH
    }

    enum ListSourceType {
        MANUAL
        CSV_UPLOAD
        RSS_FEED
    }

    enum WorkflowStatus {
        PENDING
        APPROVED
        REJECTED
        REVISION_NEEDED
    }

    enum InboxItemType {
        DIRECT_MESSAGE
        COMMENT
        MENTION
        REVIEW
    }

    enum ReportFormat {
        PDF
        CSV
        LOOKER_STUDIO
    }

    enum TeamStatus {
        PENDING
        ACTIVE
        REMOVED
    }
}

' ==================== CORE ENTITIES ====================
package "Core Entities (Nền tảng hệ thống)" #EEEDFE {
    class User {
        ** PK & Identification **
        - id: UUID
        - email: String ⭐ unique
        - passwordHash: String (bcrypt)
        - name: String
        - avatarUrl: String?
        --
        ** Roles & Permissions **
        - role: UserRole (OWNER|ADMIN|EDITOR|VIEWER|ANALYST)
        --
        ** Settings **
        - language: String (ISO 639-1, e.g., en, vi)
        - timezone: String (IANA, e.g., UTC, Asia/Ho_Chi_Minh)
        - isEmailVerified: Boolean
        --
        ** Activity Tracking **
        - lastLoginAt: DateTime?
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getPermissions(): Permission[]
        + hasRole(role: UserRole): Boolean
        + isOwnerOf(brand: Brand): Boolean
        + isTeamMemberOf(brand: Brand): Boolean
    }

    class Brand {
        ** PK & Identification **
        - id: UUID
        - name: String
        - logoUrl: String?
        --
        ** Foreign Keys **
        - ownerId: UUID → User
        - subscriptionId: UUID → Subscription
        --
        ** Settings **
        - timezone: String (IANA)
        - defaultLanguage: String (ISO 639-1)
        - isActive: Boolean (hoạt động hay tạm dừng)
        --
        ** Usage Tracking **
        - postsUsedThisMonth: Integer (bài đã đăng trong tháng)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getSocialAccounts(): SocialAccount[]
        + getAdAccounts(): AdAccount[]
        + getPosts(): Post[]
        + getCurrentMonthPostsUsed(): Integer
        + canPublishPost(): Boolean (check quota)
    }

    class Team {
        ** PK **
        - id: UUID
        --
        ** Foreign Keys **
        - brandId: UUID → Brand
        - userId: UUID → User (thành viên)
        - invitedByUserId: UUID → User (người mời)
        --
        ** Role & Permissions **
        - role: UserRole (vai trò trong brand này)
        - status: TeamStatus (PENDING|ACTIVE|REMOVED)
        --
        ** Timestamps **
        - invitedAt: DateTime
        - acceptedAt: DateTime?
        --
        + accept(): void
        + reject(): void
        + changeRole(newRole: UserRole): void
    }

    class Subscription {
        ** PK **
        - id: UUID
        --
        ** Foreign Key **
        - brandId: UUID → Brand
        --
        ** Plan & Pricing **
        - planType: PlanType (FREE|STARTER|ADVANCED|CUSTOM)
        - priceAmount: Decimal (USD)
        - currency: String (ISO 4217, e.g., USD, VND)
        - billingCycle: BillingCycle (MONTHLY|ANNUAL)
        --
        ** Quotas & Limits **
        - brandLimit: Integer (số brand được tạo)
        - postsPerMonthLimit: Integer (bài/tháng)
        - teamMemberLimit: Integer (thành viên team)
        --
        ** Features Access **
        - hasWhiteLabel: Boolean (xuất report white-label)
        - hasApiAccess: Boolean (truy cập API)
        - hasLookerStudio: Boolean (kết nối Looker Studio)
        - hasApprovalWorkflow: Boolean (luồng duyệt)
        --
        ** Billing Management **
        - stripeCustomerId: String? (ID Stripe)
        - stripeSubscriptionId: String? (ID subscription Stripe)
        - startDate: DateTime
        - endDate: DateTime? (null = auto-renew)
        - cancelledAt: DateTime?
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + isActive(): Boolean
        + isExpired(): Boolean
        + upgrade(newPlan: PlanType): void
        + checkQuota(neededPosts: Integer): Boolean
        + getRemainingPosts(): Integer
    }
}

' ==================== PLATFORM & ADS ====================
package "Platform & Ads Integration (Kết nối nền tảng)" #E1F5EE {
    abstract class SocialAccount {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** Platform Connection **
        - platform: PlatformType (INSTAGRAM|FACEBOOK|TIKTOK|LINKEDIN…)
        - platformAccountId: String (ID gốc từ nền tảng)
        - username: String
        - displayName: String
        - profilePictureUrl: String?
        --
        ** OAuth Tokens **
        - accessToken: String (encrypted, từ nền tảng)
        - refreshToken: String? (encrypted)
        - tokenExpiresAt: DateTime? (thời hạn token)
        - scopes: String[] (quyền đã cấp)
        --
        ** Connection Status **
        - isConnected: Boolean (kết nối còn hiệu lực)
        - connectedAt: DateTime
        - lastSyncAt: DateTime? (lần sync metrics gần nhất)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        {abstract} + publishPost(post: Post): String (return platformPostId)
        {abstract} + getMetrics(): Map<String, Any>
        + disconnect(): void
        + refreshAccessToken(): void
        + getProfile(): Object
        + isTokenExpired(): Boolean
    }

    class InstagramAccount {
        ** Inheritance **
        extends SocialAccount
        --
        ** Account Details **
        - accountType: String (BUSINESS|CREATOR)
        - businessCategoryName: String?
        - biography: String?
        - website: String? (link trong bio)
        --
        ** Followers & Engagement **
        - followersCount: Integer
        - followingCount: Integer
        - mediaCount: Integer (tổng bài đăng)
        --
        ** Features Support **
        - supportsStories: Boolean
        - supportsReels: Boolean
        - supportsCarousels: Boolean
        - supportsCollaboration: Boolean (Collab posts)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + publishPost(post: Post): String
        + publishStory(media: Media[]): String
        + publishReel(video: Media): String
        + getInsights(period: String): SocialAnalytics
        + getFollowersDemographics(): JSON
    }

    class FacebookPage {
        ** Inheritance **
        extends SocialAccount
        --
        ** Page Details **
        - pageId: String (ID trang Facebook)
        - category: String?
        - about: String?
        - website: String?
        --
        ** Metrics **
        - likesCount: Integer (lượt thích)
        - followersCount: Integer
        - isPublished: Boolean (trạng thái công khai)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + publishPost(post: Post): String
        + schedulePost(post: Post, scheduledAt: DateTime): String
        + getPageInsights(metric: String): JSON
        + getComments(postId: String): InboxItem[]
    }

    class TikTokAccount {
        ** Inheritance **
        extends SocialAccount
        --
        ** Metrics **
        - followersCount: Integer
        - followingCount: Integer
        - likesCount: Integer (tổng tim nhận)
        - videoCount: Integer
        - isVerified: Boolean (tick xanh)
        --
        ** Features **
        - supportsCarousels: Boolean (TikTok carousel)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + publishVideo(post: Post): String
        + getTrendingHashtags(): String[]
        + getCreatorAnalytics(): JSON
        + getBioLink(): String
    }

    class LinkedInAccount {
        ** Inheritance **
        extends SocialAccount
        --
        ** Account Details **
        - accountType: String (PERSONAL|PAGE)
        - industry: String?
        - isPremiumRequired: Boolean (cần LinkedIn Premium)
        --
        ** Metrics **
        - connectionsCount: Integer? (personal only)
        - followersCount: Integer
        --
        ** Features **
        - supportsCarousels: Boolean (PDF carousel)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + publishArticle(post: Post): String
        + sharePost(post: Post): String
        + getCompanyAnalytics(): JSON
    }

    class AdAccount {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** Account Details **
        - platform: AdPlatformType (META_ADS|GOOGLE_ADS|TIKTOK_ADS)
        - platformAccountId: String (ID từ nền tảng)
        - accountName: String
        --
        ** Configuration **
        - currency: String (ISO 4217)
        - timezone: String (IANA)
        - isActive: Boolean (theo dõi hay không)
        --
        ** Authentication **
        - accessToken: String (encrypted)
        - lastSyncAt: DateTime?
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + createCampaign(campaign: Campaign): String
        + pauseCampaign(campaignId: String): void
        + getBudgetStatus(): Object
        + getMetrics(period: DateRange): AdAnalytics
    }

    class Campaign {
        ** PK & FK **
        - id: UUID
        - adAccountId: UUID → AdAccount
        --
        ** Campaign Details **
        - platformCampaignId: String (ID gốc)
        - name: String
        - status: String (ACTIVE|PAUSED|COMPLETED)
        - objective: String (AWARENESS|TRAFFIC|CONVERSIONS…)
        --
        ** Budget & Scheduling **
        - dailyBudget: Decimal
        - totalBudget: Decimal?
        - bidAmount: Decimal
        - startDate: DateTime
        - endDate: DateTime?
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + launch(): void
        + pause(): void
        + resume(): void
        + getPerformance(): AdAnalytics
        + adjustBudget(newBudget: Decimal): void
    }
}

' ==================== CONTENT & SCHEDULING ====================
package "Content & Scheduling (Quản lý nội dung)" #FAEEDA {
    class Post {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        - createdByUserId: UUID → User
        - autoListId: UUID? → AutoList
        --
        ** Content **
        - caption: Text
        - type: PostType (IMAGE|VIDEO|CAROUSEL|REEL…)
        - mediaUrls: String[] (ảnh/video)
        - mediaThumbnailUrls: String[]
        - altText: String? (accessibility)
        --
        ** Engagement Elements **
        - hashtags: String[] (#tag)
        - mentions: String[] (@user)
        - firstComment: Text? (comment tự động)
        - locationId: String?
        - locationName: String?
        - linkUrl: String?
        --
        ** Distribution **
        - targetPlatforms: PlatformType[] (nền tảng sẽ đăng)
        - isCollaboration: Boolean (hợp tác post)
        - collaboratorHandle: String?
        --
        ** Status & Scheduling **
        - status: PostStatus (DRAFT|SCHEDULED|PENDING_APPROVAL|PUBLISHED|FAILED)
        - scheduledAt: DateTime?
        - publishedAt: DateTime?
        - failureReason: String?
        --
        ** Platform Integration **
        - platformPostIds: Map<PlatformType, String> (ID trên từng nền)
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + schedule(): void
        + publish(): void
        + publishToMultiplePlatforms(): void
        + requestApproval(): void
        + getEngagementMetrics(): SocialAnalytics
        + duplicate(): Post
        + archive(): void
    }

    class ContentCalendar {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** View Settings **
        - defaultView: CalendarView (DAY|WEEK|MONTH)
        - countryCalendars: String[] (ISO 3166, holidays)
        - showBestTimes: Boolean
        --
        ** Filters **
        - filterPlatforms: PlatformType[]?
        - filterStatuses: PostStatus[]?
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getPostsByDate(date: Date): Post[]
        + getPostsByPlatform(platform: PlatformType): Post[]
        + getPostsByStatus(status: PostStatus): Post[]
        + visualizeMonth(year: Integer, month: Integer): CalendarView
        + getBestTimeSlotsForDay(date: Date): BestTimeSlot[]
    }

    class BestTimeSlot {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** Timing **
        - platform: PlatformType
        - dayOfWeek: Integer (0=SUN, 1=MON… 6=SAT)
        - hour: Integer (0-23, theo timezone)
        --
        ** Scoring **
        - engagementScore: Float (0.0-1.0, 1.0 = giờ vàng)
        - confidenceLevel: String (HIGH|MEDIUM|LOW)
        --
        ** Calculation **
        - calculatedAt: DateTime
        --
        + getScore(): Float
        + isGoldenHour(): Boolean
        + getRecommendationText(): String
        + updateScoreFromAnalytics(analytics: SocialAnalytics): void
    }

    class AutoList {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** List Details **
        - name: String
        - sourceType: ListSourceType (MANUAL|CSV_UPLOAD|RSS_FEED)
        - rssUrl: String?
        - csvLastUploadedAt: DateTime?
        --
        ** Distribution **
        - targetPlatforms: PlatformType[]
        --
        ** Scheduling **
        - scheduleType: String (INTERVAL|SPECIFIC_TIMES|BEST_TIMES)
        - intervalMinutes: Integer? (khoảng thời gian giữa posts)
        - specificTimes: Time[]? (giờ cụ thể)
        --
        ** Status & Progress **
        - isActive: Boolean
        - loopEnabled: Boolean (lặp lại)
        - totalPostsCount: Integer
        - publishedPostsCount: Integer
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + addItem(content: String): void
        + importFromCSV(file: File): void
        + subscribeFeed(rssUrl: String): void
        + autoPublishNext(): Post
        + getProgress(): Float
        + pause(): void
        + resume(): void
    }

    class ApprovalWorkflow {
        ** PK & FK **
        - id: UUID
        - postId: UUID → Post
        - brandId: UUID → Brand
        - requesterId: UUID → User (gửi duyệt)
        - approverId: UUID? → User (được chỉ định)
        - reviewedByUserId: UUID? → User (thực tế duyệt)
        --
        ** Workflow Details **
        - status: WorkflowStatus (PENDING|APPROVED|REJECTED|REVISION_NEEDED)
        - version: Integer (phiên bản, tăng khi submit lại)
        --
        ** Comments & Feedback **
        - requesterNote: Text?
        - reviewerComment: Text?
        - revisionNote: Text? (hướng dẫn sửa)
        --
        ** Timestamps **
        - requestedAt: DateTime
        - reviewedAt: DateTime?
        --
        + approve(): void
        + reject(reason: String): void
        + requestRevision(feedback: String): void
        + getHistory(): ReviewLog[]
        + reassignTo(user: User): void
        + notifyReviewer(): void
    }

    class ReviewLog {
        ** PK & FK **
        - id: UUID
        - workflowId: UUID → ApprovalWorkflow
        - userId: UUID → User
        --
        ** Action Details **
        - action: String (SUBMITTED|APPROVED|REJECTED|REVISION_REQUESTED)
        - comment: Text
        - version: Integer
        --
        ** Timestamps **
        - timestamp: DateTime
        --
        + getDetails(): Object
    }

    class Media {
        ** PK & FK **
        - id: UUID
        - postId: UUID? → Post
        --
        ** File Details **
        - type: String (IMAGE|VIDEO|GIF|DOCUMENT)
        - filename: String
        - mimeType: String (image/jpeg, video/mp4…)
        - sizeBytes: Long
        --
        ** Dimensions **
        - width: Integer?
        - height: Integer?
        - durationSeconds: Float? (video)
        --
        ** Storage **
        - storageUrl: String (URL từ CDN)
        - thumbnailUrl: String?
        --
        ** Timestamps **
        - uploadedAt: DateTime
        --
        + getUrl(): String
        + getThumbnail(): String
        + delete(): void
    }
}

' ==================== ANALYTICS & REPORTS ====================
package "Analytics & Reports (Phân tích dữ liệu)" #FBEAF0 {
    abstract class Analytics {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        - socialAccountId: UUID? → SocialAccount
        --
        ** Period **
        - dateFrom: Date
        - dateTo: Date
        - granularity: String (DAY|WEEK|MONTH)
        --
        ** Metadata **
        - fetchedAt: DateTime
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        {abstract} + calculate(): void
        + compare(otherPeriod: DateRange): ComparisonResult
        + export(): Object
        + toJSON(): String
    }

    class SocialAnalytics {
        ** Inheritance **
        extends Analytics
        --
        ** Followers **
        - followersTotal: Integer (tổng followers cuối kỳ)
        - followersGain: Integer (follow mới)
        - followersLost: Integer (unfollow)
        --
        ** Reach & Impressions **
        - impressions: Integer (hiển thị)
        - reach: Integer (người duy nhất tiếp cận)
        --
        ** Engagement **
        - engagements: Integer (tổng: like+comment+share+save)
        - likes: Integer
        - comments: Integer
        - shares: Integer
        - saves: Integer (bookmark)
        - clicks: Integer (link click)
        - engagementRate: Float (% = engagements/reach×100)
        --
        ** Video Metrics **
        - videoViews: Integer?
        - avgVideoWatchTime: Float? (giây)
        --
        ** Other Metrics **
        - profileVisits: Integer?
        - websiteClicks: Integer? (link bio)
        --
        ** Advanced Data **
        - topPostIds: UUID[]? (top posts)
        - audienceDemographicsJson: JSON? (tuổi, giới, vị trí)
        - hourlyEngagementJson: JSON? (engagement/giờ)
        --
        + getEngagementRate(): Float
        + getTopPost(): Post
        + getBestHour(): Integer
        + getAudienceDemographics(): JSON
        + getGrowthRate(): Float
    }

    class AdAnalytics {
        ** Inheritance **
        extends Analytics
        --
        ** Foreign Key **
        - adAccountId: UUID → AdAccount
        --
        ** Campaign Details **
        - campaignId: String?
        - campaignName: String?
        - adSetId: String?
        --
        ** Budget & Cost **
        - totalSpend: Decimal (tổng chi)
        - cpc: Decimal (Cost Per Click)
        - cpm: Decimal (Chi phí/1000 hiển thị)
        - cpa: Decimal (Chi phí/conversion)
        --
        ** Performance **
        - impressions: Integer
        - clicks: Integer
        - ctr: Float (Click-Through Rate %)
        - reach: Integer (người unique)
        - frequency: Float (lần hiển thị/người)
        --
        ** Conversions **
        - conversions: Integer
        - conversionValue: Decimal
        - roas: Float (Return On Ad Spend)
        --
        ** Video (if applicable) **
        - videoViews: Integer?
        - videoWatchRate: Float? (% xem hết)
        --
        ** Breakdown **
        - campaignBreakdownJson: JSON?
        --
        + calculateROI(): Float
        + getCostEfficiency(): Float
        + getTopPerformingCampaign(): String
        + optimizeBudget(): Recommendation[]
    }

    class WebsiteAnalytics {
        ** Inheritance **
        extends Analytics
        --
        ** Source **
        - source: String (GOOGLE_ANALYTICS|PIXEL)
        - propertyId: String
        --
        ** Traffic **
        - sessions: Integer (phiên truy cập)
        - uniqueVisitors: Integer
        - pageViews: Integer
        --
        ** Behavior **
        - avgSessionDuration: Integer (giây)
        - bounceRate: Float (%)
        - newVisitorRate: Float (%)
        --
        ** Attribution **
        - socialReferrals: Integer (từ social)
        --
        ** Advanced **
        - topLandingPagesJson: JSON?
        - trafficSourcesJson: JSON? (organic, direct, social…)
        - conversionsJson: JSON?
        --
        + getTopPages(): Page[]
        + getTrafficSource(): JSON
        + getConversionFunnel(): JSON
        + getSocialTraffic(): Integer
    }

    class CompetitorAnalysis {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** Competitor Details **
        - platform: PlatformType
        - competitorHandle: String
        - competitorDisplayName: String?
        - competitorAvatarUrl: String?
        --
        ** Metrics **
        - followersCount: Integer?
        - avgEngagementRate: Float?
        - postsPerWeek: Float?
        --
        ** Tracking **
        - lastFetchedAt: DateTime?
        - addedAt: DateTime
        --
        + updateMetrics(): void
        + compareWith(brand: Brand): ComparisonResult
        + getWeakPoints(): String[]
        + getStrengths(): String[]
        + getRecommendations(): String[]
    }

    class Report {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        - createdByUserId: UUID → User
        --
        ** Content **
        - title: String
        - description: Text?
        - dateFrom: Date
        - dateTo: Date
        --
        ** Configuration **
        - includedPlatforms: PlatformType[]
        - includedSections: String[] (SOCIAL|ADS|WEB|COMPETITORS)
        - format: ReportFormat (PDF|CSV|LOOKER_STUDIO)
        --
        ** Branding **
        - isWhiteLabel: Boolean
        - brandLogoUrl: String?
        - brandColorHex: String? (#RRGGBB)
        --
        ** File & Distribution **
        - fileUrl: String? (null nếu chưa generate)
        - scheduledFrequency: String? (WEEKLY|MONTHLY)
        - scheduledDeliveryEmails: String[]
        - nextScheduledAt: DateTime?
        --
        ** Tracking **
        - generatedAt: DateTime?
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + generate(): void
        + export(format: ReportFormat): File
        + share(emails: String[]): void
        + schedule(frequency: String, emails: String[]): void
        + download(format: ReportFormat): Binary
    }
}

' ==================== COMMUNICATION ====================
package "Communication (Giao tiếp)" #E6F1FB {
    class UnifiedInbox {
        ** PK & FK **
        - id: UUID
        - brandId: UUID → Brand
        --
        ** Status **
        - totalUnread: Integer (tính toán)
        --
        ** Filtering **
        - filterPlatforms: PlatformType[]?
        - filterTypes: InboxItemType[]?
        --
        ** Sync **
        - lastSyncAt: DateTime?
        --
        ** Timestamps **
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getMessages(): InboxItem[]
        + getUnreadCount(): Integer
        + markAsRead(itemId: UUID): void
        + markAllAsRead(): void
        + sendReply(itemId: UUID, message: String): void
        + deleteItem(itemId: UUID): void
        + filterBy(type: InboxItemType, platform: PlatformType): InboxItem[]
    }

    class InboxItem {
        ** PK & FK **
        - id: UUID
        - inboxId: UUID → UnifiedInbox
        - relatedPostId: UUID? → Post
        - parentItemId: UUID? (trả lời comment)
        - repliedByUserId: UUID? → User
        --
        ** Source & Type **
        - platform: PlatformType
        - type: InboxItemType (DM|COMMENT|MENTION|REVIEW)
        - platformItemId: String (ID gốc)
        --
        ** Author **
        - authorId: String
        - authorName: String
        - authorAvatarUrl: String?
        --
        ** Content **
        - content: Text
        - mediaUrls: String[]?
        --
        ** Status **
        - status: String (UNREAD|READ|REPLIED|ARCHIVED)
