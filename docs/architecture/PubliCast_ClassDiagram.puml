@startuml PubliCast_Architecture
skinparam monochrome true
skinparam shading false
!theme plain
skinparam backgroundColor #FEFEFE




' ==================== CORE ENTITIES ====================
package "Core Entities"  {
    class User {
        - userId: UUID
        - email: string
        - password: string (hashed)
        - firstName: string
        - lastName: string
        - avatar: string
        - userRole: enum[OWNER|ADMIN|EDITOR|VIEWER|ANALYST]
        - permissions: Permission[]
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getPermissions(): Permission[]
        + hasRole(role: UserRole): boolean
        + updateProfile(data: Object): void
        + changePassword(oldPwd: string, newPwd: string): void
    }

    class Brand {
        - brandId: UUID
        - name: string
        - logoUrl: string
        - description: string
        - owner: User
        - website: string
        - industry: string
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + getSocialAccounts(): SocialAccount[]
        + getAnalytics(period: string): Analytics[]
        + createPost(postData: Object): Post
        + getTeams(): Team[]
        + getSubscription(): Subscription
    }

    class Team {
        - teamId: UUID
        - name: string
        - description: string
        - brand: Brand
        - members: User[]
        - createdAt: DateTime
        - updatedAt: DateTime
        --
        + addMember(user: User, role: UserRole): void
        + removeMember(userId: UUID): void
        + updatePermissions(userId: UUID, perms: Permission[]): void
        + getMembers(): User[]
    }

    class Subscription {
        - subscriptionId: UUID
        - brand: Brand
        - tier: enum[FREE|STARTER|ADVANCED|CUSTOM]
        - brandLimit: int
        - postsPerMonthLimit: int
        - maxTeamMembers: int
        - hasAnalytics: boolean
        - hasAdAccount: boolean
        - startDate: DateTime
        - endDate: DateTime
        - price: float
        - isActive: boolean
        --
        + upgrade(newTier: string): void
        + checkLimit(): boolean
        + getRemainingPosts(): int
        + isExpired(): boolean
        + autoRenew(): void
    }

    class Permission {
        - permissionId: UUID
        - name: string
        - description: string
        - action: string
        --
        + validate(): boolean
    }
}

' ==================== PLATFORM & ADS ====================
package "Platform & Ads"  {
    abstract class SocialAccount {
        - accountId: UUID
        - brand: Brand
        - platform: enum[INSTAGRAM|FACEBOOK|TIKTOK|LINKEDIN]
        - accessToken: string
        - refreshToken: string
        - expiresAt: DateTime
        - isActive: boolean
        - connectedAt: DateTime
        - disconnectedAt: DateTime
        --
        {abstract} + publish(post: Post): void
        {abstract} + getMetrics(): Map<string, any>
        + refreshToken(): void
        + disconnect(): void
        + getProfile(): Object
    }

    class InstagramAccount {
        - businessAccountId: string
        - username: string
        - followers: int
        - followingCount: int
        - bioLink: string
        - instagramUrl: string
        --
        + publishPost(post: Post): void
        + publishStory(story: Story): void
        + getInsights(): InstagramInsights
        + getReels(): Reel[]
        + getFollowersDemographics(): Object
    }

    class FacebookPage {
        - pageId: string
        - pageName: string
        - pageFollowers: int
        - accessLevel: string
        - facebookUrl: string
        --
        + publishPost(post: Post): void
        + getPageInsights(): PageInsights
        + schedulePost(post: Post, scheduleTime: DateTime): void
        + getComments(postId: string): Comment[]
    }

    class TikTokAccount {
        - tiktokUserId: string
        - username: string
        - followers: int
        - isVerified: boolean
        - tiktokUrl: string
        --
        + publishVideo(video: Video): void
        + getTrendingHashtags(): string[]
        + getCreatorAnalytics(): CreatorAnalytics
        + getSounds(): Sound[]
    }

    class LinkedInAccount {
        - linkedinUserId: string
        - profileUrl: string
        - connections: int
        - headline: string
        - linkedinUrl: string
        --
        + publishArticle(article: Article): void
        + sharePost(post: Post): void
        + getCompanyAnalytics(): CompanyAnalytics
        + getConnections(): int
    }

    class AdAccount {
        - adAccountId: UUID
        - brand: Brand
        - platform: enum[META|GOOGLE|TIKTOK]
        - accountNumber: string
        - budget: float
        - spendLimit: float
        - spent: float
        - currency: string
        - isActive: boolean
        - createdAt: DateTime
        --
        + createCampaign(campaign: Campaign): void
        + getBudgetStatus(): BudgetStatus
        + getAdMetrics(): AdMetrics
        + pauseCampaign(campaignId: UUID): void
        + calculateSpend(): float
    }

    class Campaign {
        - campaignId: UUID
        - adAccount: AdAccount
        - name: string
        - status: enum[ACTIVE|PAUSED|COMPLETED|ARCHIVED]
        - budget: float
        - bidAmount: float
        - startDate: DateTime
        - endDate: DateTime
        --
        + launch(): void
        + pause(): void
        + getPerformance(): CampaignMetrics
    }
}

' ==================== CONTENT & SCHEDULING ====================
package "Content & Scheduling"  {
    class Post {
        - postId: UUID
        - brand: Brand
        - title: string
        - content: string
        - mediaType: enum[IMAGE|VIDEO|CAROUSEL|REEL|STORY|THREAD|PIN]
        - media: Media[]
        - platforms: SocialAccount[]
        - postStatus: enum[DRAFT|PENDING_APPROVAL|APPROVED|REJECTED|REVISION|SCHEDULED|PUBLISHED|ARCHIVED]
        - scheduleTime: DateTime
        - publishedAt: DateTime
        - createdBy: User
        - createdAt: DateTime
        - approvedBy: User
        - approvedAt: DateTime
        - hashtags: string[]
        - mentions: User[]
        --
        + schedule(): void
        + publish(): void
        + approve(): void
        + reject(reason: string): void
        + getEngagementMetrics(): PostMetrics
        + duplicate(): Post
        + archive(): void
    }

    class ContentCalendar {
        - calendarId: UUID
        - brand: Brand
        - posts: Post[]
        - month: int
        - year: int
        - timezone: string
        --
        + getPostsByDate(date: Date): Post[]
        + getPostsByPlatform(platform: string): Post[]
        + visualizeTimeline(): void
        + getMonthView(): MonthView
        + getWeekView(): WeekView
    }

    class BestTimeSlot {
        - slotId: UUID
        - platform: enum[INSTAGRAM|FACEBOOK|TIKTOK|LINKEDIN]
        - dayOfWeek: enum[MON|TUE|WED|THU|FRI|SAT|SUN]
        - hour: int (0-23)
        - engagementScore: float (0-100)
        - audienceOnlinePercentage: float
        - confidence: float
        --
        + calculateBestTime(): Time
        + getRecommendation(): Object
        + updateScore(newEngagement: float): void
    }

    class AutoList {
        - listId: UUID
        - brand: Brand
        - name: string
        - description: string
        - source: enum[MANUAL|CSV|RSS|API]
        - items: AutoListItem[]
        - schedule: cron (ví dụ: "0 9 * * MON")
        - isActive: boolean
        - createdAt: DateTime
        --
        + addItem(item: string): void
        + removeItem(itemId: UUID): void
        + importFromCSV(file: File): void
        + subscribeFeed(rssUrl: string): void
        + autoSchedulePosts(): void
        + getNextExecution(): DateTime
    }

    class AutoListItem {
        - itemId: UUID
        - autoList: AutoList
        - content: string
        - order: int
        - used: boolean
        - usedAt: DateTime
        --
        + createPost(): Post
        + markAsUsed(): void
    }

    class ApprovalWorkflow {
        - workflowId: UUID
        - post: Post
        - status: enum[PENDING|APPROVED|REJECTED|REVISION|RESOLVED]
        - reviewer: User
        - reviewedAt: DateTime
        - comments: string
        - reviewHistory: ReviewLog[]
        - requiresMultipleReviews: boolean
        - requiredApprovals: int
        - currentApprovals: int
        --
        + approve(): void
        + reject(reason: string): void
        + requestRevision(feedback: string): void
        + getHistory(): ReviewLog[]
        + addReviewer(user: User): void
    }

    class ReviewLog {
        - logId: UUID
        - workflow: ApprovalWorkflow
        - reviewer: User
        - action: string
        - comment: string
        - timestamp: DateTime
        - version: int
        --
        + getDetails(): Object
    }

    class Media {
        - mediaId: UUID
        - post: Post
        - type: enum[IMAGE|VIDEO|GIF|DOCUMENT]
        - url: string
        - fileSize: long
        - width: int
        - height: int
        - duration: int (for video)
        - uploadedAt: DateTime
        --
        + getUrl(): string
        + delete(): void
    }
}

' ==================== ANALYTICS & REPORTS ====================
package "Analytics & Reports"  {
    abstract class Analytics {
        - analyticsId: UUID
        - post: Post
        - platform: string
        - timestamp: DateTime
        - period: enum[DAILY|WEEKLY|MONTHLY]
        - metrics: Map<string, any>
        --
        {abstract} + calculate(): void
        + compare(otherPeriod: DateTime): ComparisonResult
        + export(): Object
    }

    class SocialAnalytics {
        - impressions: long
        - reach: long
        - likes: long
        - comments: long
        - shares: long
        - saves: long
        - clicks: long
        - engagementRate: float
        - clickThroughRate: float
        --
        + getTopPost(): Post
        + getBestTime(): Time
        + getAudienceDemographics(): Object
        + getTrendingContent(): string[]
    }

    class AdAnalytics {
        - impressions: long
        - clicks: long
        - ctr: float (Click Through Rate)
        - cpc: float (Cost Per Click)
        - spend: float
        - revenue: float
        - roas: float (Return On Ad Spend)
        - conversions: int
        - conversionRate: float
        - roi: float
        --
        + calculateROI(): float
        + optimizeBudget(): void
        + getCostAnalysis(): Object
    }

    class WebsiteAnalytics {
        - pageViews: long
        - sessions: long
        - bounceRate: float
        - averageSessionDuration: float
        - conversionRate: float
        - trafficSources: Map<string, long>
        - devices: Map<string, long>
        --
        + getTopPages(): Page[]
        + getUserBehavior(): Object
        + getFunnelAnalysis(): Funnel
    }

    class Report {
        - reportId: UUID
        - brand: Brand
        - name: string
        - description: string
        - format: enum[PDF|CSV|LOOKER_STUDIO|JSON]
        - analytics: Analytics[]
        - generatedAt: DateTime
        - whiteLabelable: boolean
        - customBranding: CustomBranding
        - recipients: string[]
        - isScheduled: boolean
        - schedule: cron
        --
        + generate(): void
        + export(format: string): File
        + share(email: string): void
        + schedule(cron: string): void
        + downloadPDF(): File
    }

    class CompetitorAnalysis {
        - analysisId: UUID
        - brand: Brand
        - competitors: Brand[]
        - metrics: Map<string, float>
        - benchmarks: float[]
        - analyzeDate: DateTime
        - updateFrequency: string
        --
        + compareMetrics(): ComparisonTable
        + identifyGaps(): Gap[]
        + getRecommendations(): string[]
        + trendAnalysis(): Trend[]
    }

    class CustomBranding {
        - brandingId: UUID
        - logoUrl: string
        - primaryColor: string
        - secondaryColor: string
        - fontFamily: string
        - companyName: string
        --
        + apply(): void
        + validate(): boolean
    }
}

' ==================== UTILITIES ====================
package "Utilities"  {
    class UnifiedInbox {
        - inboxId: UUID
        - brand: Brand
        - items: InboxItem[]
        - unreadCount: int
        - lastCheckedAt: DateTime
        --
        + getMessages(): InboxItem[]
        + markAsRead(itemId: UUID): void
        + markAllAsRead(): void
        + sendReply(itemId: UUID, message: string): void
        + deleteItem(itemId: UUID): void
        + getUnreadCount(): int
        + filterByType(type: string): InboxItem[]
    }

    class InboxItem {
        - itemId: UUID
        - inboxId: UUID
        - type: enum[DM|COMMENT|MENTION|REPORT]
        - platform: string (INSTAGRAM|FACEBOOK|TIKTOK|LINKEDIN)
        - author: string
        - authorId: string
        - content: string
        - attachments: string[]
        - isRead: boolean
        - receivedAt: DateTime
        - readAt: DateTime
        - post: Post
        --
        + markAsRead(): void
        + reply(message: string): void
        + like(): void
        + delete(): void
        + getRelatedPost(): Post
    }

    class SmartLink {
        - linkId: UUID
        - brand: Brand
        - bioUrl: string
        - title: string
        - description: string
        - items: LinkItem[]
        - analytics: SmartLinkAnalytics
        - theme: string
        - customDomain: string
        --
        + addLink(linkItem: LinkItem): void
        + removeLink(itemId: UUID): void
        + reorderLinks(order: UUID[]): void
        + getClickAnalytics(): SmartLinkAnalytics
        + publish(): void
    }

    class LinkItem {
        - itemId: UUID
        - smartLink: SmartLink
        - url: string
        - title: string
        - description: string
        - icon: string
        - order: int
        - clicks: long
        - lastClickedAt: DateTime
        - isActive: boolean
        --
        + updateOrder(newOrder: int): void
        + getClickStats(): ClickStats
        + generateQR(): QRCode
    }

    class HashtagTracker {
        - trackerId: UUID
        - brand: Brand
        - hashtags: string[]
        - trendingHashtags: string[]
        - trackingPeriod: DateTime
        - updateFrequency: string
        - trackedHashtags: TrackedHashtag[]
        --
        + addHashtag(tag: string): void
        + removeHashtag(tag: string): void
        + getTrendingTags(): string[]
        + analyzePerformance(): PerformanceMetrics
        + getVolumeTrend(tag: string): Trend[]
    }

    class TrackedHashtag {
        - trackedId: UUID
        - hashtag: string
        - tracker: HashtagTracker
        - volume: long
        - engagement: float
        - lastUpdated: DateTime
        --
        + updateMetrics(): void
        + getTopPosts(): Post[]
    }

    class AIAssistant {
        - assistantId: UUID
        - brand: Brand
        - model: string (GPT-4, Claude, etc)
        - tone: string (Professional|Casual|Funny)
        - language: string
        --
        + suggestContent(topic: string): string[]
        + suggestHashtags(content: string): string[]
        + suggestBestTime(platforms: string[]): Time[]
        + generateCaption(image: Image): string
        + improveCopy(text: string): string
        + generateIdeas(niche: string): Idea[]
    }

    class MediaLibrary {
        - libraryId: UUID
        - brand: Brand
        - assets: Asset[]
        - folders: Folder[]
        - totalSize: long
        - maxSize: long
        --
        + uploadAsset(file: File): Asset
        + deleteAsset(assetId: UUID): void
        + organizeByTag(tag: string): void
        + searchAsset(query: string): Asset[]
        + createFolder(name: string): Folder
        + moveAsset(assetId: UUID, folderId: UUID): void
    }

    class Asset {
        - assetId: UUID
        - mediaLibrary: MediaLibrary
        - name: string
        - type: enum[IMAGE|VIDEO|DOCUMENT|AUDIO]
        - url: string
        - fileSize: long
        - width: int
        - height: int
        - tags: string[]
        - uploadedAt: DateTime
        - folder: Folder
        --
        + getUrl(): string
        + generateThumbnail(): Image
        + addTag(tag: string): void
        + removeTag(tag: string): void
    }

    class Folder {
        - folderId: UUID
        - mediaLibrary: MediaLibrary
        - name: string
        - parent: Folder
        - children: Folder[]
        --
        + createSubFolder(name: string): Folder
        + deleteFolder(): void
        + rename(newName: string): void
    }
}

' ==================== RELATIONSHIPS ====================
User "1" --> "many" Brand : owns
User "many" --> "many" Team : joins
Brand "1" --> "1" Subscription : has
Brand "1" --> "many" Team : manages
Brand "1" --> "many" SocialAccount : owns
Brand "1" --> "many" AdAccount : owns
Brand "1" --> "many" Post : creates
Brand "1" --> "1" ContentCalendar : maintains
Brand "1" --> "1" UnifiedInbox : has
Brand "many" --> "many" SmartLink : owns
Brand "1" --> "1" HashtagTracker : uses
Brand "1" --> "1" AIAssistant : uses
Brand "1" --> "1" MediaLibrary : has
Brand "1" --> "many" Report : generates
Brand "1" --> "1" CompetitorAnalysis : tracks

Post "1" --> "1" ApprovalWorkflow : goes_through
Post "many" --> "1" ContentCalendar : scheduled_in
Post "1" --> "many" Analytics : generates
Post "many" --> "many" SocialAccount : published_to
Post "1" --> "many" Media : contains
Post "many" --> "many" Campaign : in

ContentCalendar "1" --> "many" BestTimeSlot : uses
AutoList "1" --> "many" AutoListItem : contains
AutoList "1" --> "many" Post : creates

ApprovalWorkflow "1" --> "many" ReviewLog : maintains
ApprovalWorkflow "many" --> "1" User : reviewed_by

Analytics "1" <|-- SocialAnalytics : extends
Analytics "1" <|-- AdAnalytics : extends
Analytics "1" <|-- WebsiteAnalytics : extends
Analytics "many" --> "1" Report : included_in

SocialAccount "1" <|-- InstagramAccount : extends
SocialAccount "1" <|-- FacebookPage : extends
SocialAccount "1" <|-- TikTokAccount : extends
SocialAccount "1" <|-- LinkedInAccount : extends
SocialAccount "1" --> "many" InboxItem : receives

UnifiedInbox "1" --> "many" InboxItem : contains
InboxItem "many" --> "1" SocialAccount : from

SmartLink "1" --> "many" LinkItem : contains
SmartLink "1" --> "1" SmartLinkAnalytics : generates

HashtagTracker "1" --> "many" TrackedHashtag : tracks

AdAccount "1" --> "many" Campaign : launches

MediaLibrary "1" --> "many" Asset : stores
MediaLibrary "1" --> "many" Folder : organizes
Asset "many" --> "1" Folder : organized_in
Folder "1" --> "many" Folder : contains_subfolders

Team "1" --> "many" User : has
Team "1" --> "1" Brand : part_of

User "1" --> "many" Permission : has

@enduml
