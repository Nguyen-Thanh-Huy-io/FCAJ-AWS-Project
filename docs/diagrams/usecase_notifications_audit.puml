@startuml UseCase_Notifications_Audit
title Use Case: Notifications & System Audit Logs - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false

actor "Thành viên Brand" as ActorMember
actor "Chủ Brand (Owner)" as ActorOwner
actor "Quản trị viên (Admin)" as ActorAdmin

rectangle "Notifications & Audit Logs Scope" {
    usecase "Nhận thông báo thời gian thực" as UC_ReceiveNotif
    usecase "Đánh dấu đã đọc thông báo" as UC_MarkRead
    usecase "Đánh dấu đọc tất cả thông báo" as UC_MarkAllRead
    
    usecase "Xem nhật ký hoạt động" as UC_ViewAudit
    usecase "Lọc & Tra cứu nhật ký" as UC_FilterAudit
    usecase "Xuất nhật ký ra Excel/PDF" as UC_ExportAudit
}

' Phân quyền cho Thành viên Brand nhận và tương tác với thông báo
ActorMember --> UC_ReceiveNotif
ActorMember --> UC_MarkRead
ActorMember --> UC_MarkAllRead

' Phân quyền xem nhật ký hoạt động cho Owner và Admin
ActorOwner --> UC_ViewAudit
ActorAdmin --> UC_ViewAudit

' Mở rộng các tính năng của Nhật ký hoạt động
UC_ViewAudit <.. UC_FilterAudit : <<extend>>
UC_ViewAudit ..> UC_ExportAudit : <<include>>

@enduml
