@startuml UseCase_Inbox_Analytics
title Use Case: Unified Inbox & Analytics Dashboard - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false


actor "Thành viên Brand" as ActorMember
actor "API Mạng Xã Hội (External)" as ActorSocialAPI

rectangle "Unified Inbox & Analytics Scope" {
    usecase "Xem hòm thư hợp nhất (Unified Inbox)" as UC_ViewInbox
    usecase "Đồng bộ bình luận tự động & Webhook" as UC_SyncComments
    usecase "Lọc bình luận theo trạng thái/kênh" as UC_FilterInbox
    usecase "Xem chi tiết luồng hội thoại (Threading)" as UC_ViewThread
    
    usecase "Trả lời bình luận trực tiếp" as UC_ReplyComment
    usecase "Đánh dấu trạng thái (Read/Unread/Resolved)" as UC_MarkStatus
    
    usecase "Xem thống kê hiệu suất kênh (Analytics)" as UC_ViewAnalytics
    usecase "Theo dõi lượt xem & tương tác bài đăng" as UC_TrackMetrics
}

' Unified Inbox & Tương tác
ActorMember --> UC_ViewInbox
ActorMember --> UC_ReplyComment
ActorMember --> UC_MarkStatus

' Mở rộng tính năng Inbox
UC_ViewInbox <.. UC_FilterInbox : <<extend>>
UC_ViewInbox ..> UC_ViewThread : <<include>>
UC_ViewInbox ..> UC_SyncComments : <<include>>

' Tác vụ gửi/nhận qua Social API
UC_SyncComments --> ActorSocialAPI
UC_ReplyComment --> ActorSocialAPI

' Analytics Dashboard
ActorMember --> UC_ViewAnalytics
UC_ViewAnalytics ..> UC_TrackMetrics : <<include>>

@enduml
