@startuml UseCase_Workspace_Social
title Use Case: Workspace & Social Platform Integration - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false

actor "Thành viên Brand" as ActorMember
actor "Chủ Brand (Owner)" as ActorOwner

rectangle "Workspace & Social Integration Scope" {
    usecase "Xem cấu hình Brand" as UC_ViewBrand
    usecase "Mời thành viên mới" as UC_InviteMember
    usecase "Thiết lập quyền thành viên (Roles)" as UC_ManageRoles
    
    usecase "Kết nối kênh mạng xã hội" as UC_ConnectPlatform
    usecase "Hủy kết nối kênh mạng xã hội" as UC_DisconnectPlatform
    
    usecase "Đồng bộ hóa Token xã hội" as UC_SyncTokens
    usecase "Nhận Webhook từ mạng xã hội" as UC_ReceiveWebhook
}

' Workspace & Thành viên
ActorOwner --> UC_InviteMember
ActorOwner --> UC_ManageRoles
ActorMember --> UC_ViewBrand

' Kết nối MXH
ActorOwner --> UC_ConnectPlatform
ActorOwner --> UC_DisconnectPlatform
ActorMember --> UC_ConnectPlatform

' Tác vụ đồng bộ nền
UC_ConnectPlatform ..> UC_SyncTokens : <<include>>
UC_SyncTokens <.. UC_ReceiveWebhook : <<extend>>\n(TikTok Webhook)

@enduml
