@startuml
left to right direction
skinparam packageStyle rectangle

actor "Analyst / Manager" as analyst
actor "System (CronJob)" as cron

package "Phân hệ Analytics & Reports" {
  usecase "Cào dữ liệu (Data Sync)" as UC_SYS
  usecase "Theo dõi Thống kê Dashboard" as UC13
  usecase "Theo dõi Đối thủ / Hashtag" as UC14
  usecase "Tạo/Lập lịch Báo cáo (White-label)" as UC15
}

cron --> UC_SYS
analyst --> UC13
analyst --> UC14
analyst --> UC15

UC_SYS ..> UC13 : Cung cấp Dữ liệu

@enduml
