@startuml UseCase_Authentication
title Use Case: Authentication & Account Management - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false

actor "Người dùng vãng lai" as ActorAnonymous
actor "Thành viên Brand" as ActorMember

rectangle "Authentication & Account Scope" {
    ' Đăng ký & Xác thực
    usecase "Đăng ký tài khoản mới" as UC_Register
    usecase "Xác thực mã OTP" as UC_VerifyOTP
    usecase "Gửi lại mã OTP" as UC_ResendOTP
    
    ' Đăng nhập
    usecase "Đăng nhập hệ thống (Email/Mật khẩu)" as UC_Login
    usecase "Đăng nhập bằng Google OAuth" as UC_GoogleLogin
    usecase "Đăng xuất" as UC_Logout
    
    ' Khôi phục mật khẩu
    usecase "Yêu cầu khôi phục mật khẩu" as UC_ForgotPass
    usecase "Thiết lập lại mật khẩu mới" as UC_ResetPass
    
    ' Quản lý hồ sơ (UC04)
    usecase "Quản lý Hồ sơ & Cài đặt cá nhân" as UC_ManageProfile
    usecase "Cập nhật thông tin & Ảnh đại diện" as UC_UpdateProfile
    usecase "Đổi mật khẩu (đang đăng nhập)" as UC_ChangePass
    usecase "Thiết lập tùy chọn (Ngôn ngữ/Múi giờ)" as UC_UpdateSettings
}

' Mối liên hệ đăng ký & OTP
ActorAnonymous --> UC_Register
UC_Register ..> UC_VerifyOTP : <<include>>
UC_VerifyOTP <.. UC_ResendOTP : <<extend>>

' Đăng nhập & Đăng xuất
ActorAnonymous --> UC_Login
ActorAnonymous --> UC_GoogleLogin
ActorMember --> UC_Login
ActorMember --> UC_GoogleLogin
ActorMember --> UC_Logout

' Quên mật khẩu
ActorAnonymous --> UC_ForgotPass
UC_ForgotPass ..> UC_ResetPass : <<include>>

' Quản lý hồ sơ & cài đặt
ActorMember --> UC_ManageProfile
UC_ManageProfile ..> UC_UpdateProfile : <<include>>
UC_ManageProfile ..> UC_ChangePass : <<include>>
UC_ManageProfile ..> UC_UpdateSettings : <<include>>

@enduml
