@startuml
left to right direction
skinparam packageStyle rectangle

actor "Content Creator" as creator
actor "Manager/Reviewer" as reviewer
actor "System (BullMQ)" as worker

package "Phân hệ Đăng bài & Lập lịch" {
  usecase "Soạn thảo & Tạo bài đăng (Tích hợp AI)" as UC07
  usecase "Đệ trình Phê duyệt (Approval)" as UC08a
  usecase "Duyệt bài / Từ chối" as UC08b
  usecase "Lập lịch Tự động (AutoLists)" as UC09
  usecase "Quản lý Livestream (RTMP)" as UC10
  usecase "Thực thi xuất bản lên MXH" as UC_SYS
}

creator --> UC07
creator --> UC08a
creator --> UC10
reviewer --> UC08b
reviewer --> UC09

UC08a ..> UC08b : <<include>>
worker --> UC_SYS
UC07 ..> UC_SYS : <<trigger>>
UC09 ..> UC_SYS : <<trigger>>

@enduml
