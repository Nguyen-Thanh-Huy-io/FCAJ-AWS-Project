@startuml C4_System_Context_Use_Case
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Thiết lập cấu hình hiển thị và định dạng tiếng Việt
title C4 System Context & Use Case Diagram - PubliCast System

' Định nghĩa các Actor (Personas)
Person(anonymous, "Anonymous User", "Người dùng chưa đăng nhập. Có thể xem trang chủ, đăng ký tài khoản.")
Person(authenticated_user, "Authenticated User (Member)", "Người dùng đã xác thực. Có quyền tạo bài viết, kết nối kênh MXH.")
Person(owner, "Brand Owner", "Chủ sở hữu thương hiệu. Có toàn quyền quản lý Brand, thành viên, và các gói đăng ký.")
Person(admin, "System Admin", "Quản trị viên hệ thống. Quản lý doanh thu, cấu hình giá, gói dịch vụ và tài khoản người dùng.")

' Định nghĩa hệ thống chính (System Boundary)
System(publicast_system, "PubliCast System", "Hệ thống B2B SaaS quản lý, lập lịch và tự động đăng tải nội dung đa phương tiện lên các mạng xã hội.")

' Định nghĩa các Hệ thống bên ngoài (External Systems)
System_Ext(smtp_server, "SMTP Mail Server", "Hệ thống gửi email OTP và thông báo.")
System_Ext(facebook_api, "Facebook & Instagram API", "Đăng bài viết, reels, hình ảnh và thu thập tương tác.")
System_Ext(youtube_api, "Google / YouTube API", "Đăng tải video, Shorts và xác thực OAuth2.")
System_Ext(tiktok_api, "TikTok API", "Đăng tải video ngắn và đồng bộ hóa qua Webhook.")

' Định nghĩa các mối liên kết C4 Context
Rel(anonymous, publicast_system, "Đăng ký tài khoản, xác thực OTP", "HTTPS")
Rel(authenticated_user, publicast_system, "Tạo Post, lập lịch, quản lý AutoList", "HTTPS")
Rel(owner, publicast_system, "Quản lý thành viên, Brand, đăng ký dịch vụ", "HTTPS")
Rel(admin, publicast_system, "Giám sát doanh thu, quản lý tài khoản", "HTTPS")

Rel_R(publicast_system, smtp_server, "Gửi email OTP xác thực", "SMTP")
Rel_D(publicast_system, facebook_api, "Đăng tải nội dung, Reels", "OAuth2/REST API")
Rel_D(publicast_system, youtube_api, "Đăng tải video, Shorts", "OAuth2/REST API")
Rel_D(publicast_system, tiktok_api, "Đăng tải video ngắn, Webhook", "OAuth2/REST API")

' --- PHÂN PHỐI USE CASE TRỰC QUAN ---
' Nhóm các Use Case nghiệp vụ chính của hệ thống PubliCast
newpage
title Use Case Details - PubliCast Core Features

left to right direction

actor "Người dùng vãng lai" as ActorAnonymous
actor "Thành viên Brand" as ActorMember
actor "Chủ Brand (Owner)" as ActorOwner
actor "Quản trị viên (Admin)" as ActorAdmin

rectangle "PubliCast System Boundary" {
    ' Nhóm Auth & Account
    usecase "Đăng ký & Xác thực OTP" as UC_Register
    usecase "Đăng nhập (Local/Google Auth)" as UC_Login
    usecase "Khôi phục mật khẩu" as UC_ForgotPassword
    
    ' Nhóm Post & Publishing
    usecase "Tạo & Chỉnh sửa bài viết" as UC_ManagePost
    usecase "Lập lịch xuất bản (AutoList/Interval)" as UC_SchedulePost
    usecase "Đăng bài ngay lên MXH" as UC_PublishNow
    usecase "Xem lịch sử xuất bản" as UC_ViewHistory
    
    ' Nhóm Workspace & Brand Connect
    usecase "Kết nối tài khoản mạng xã hội" as UC_ConnectSocial
    usecase "Quản lý thành viên trong Brand" as UC_ManageMembers
    
    ' Nhóm Admin
    usecase "Quản lý gói cước & Giá" as UC_ManagePricing
    usecase "Xem báo cáo doanh thu & KPIs" as UC_ViewAnalytics
}

' Liên kết Actor với Use Case
ActorAnonymous --> UC_Register
ActorAnonymous --> UC_Login
ActorAnonymous --> UC_ForgotPassword

ActorMember --> UC_Login
ActorMember --> UC_ManagePost
ActorMember --> UC_SchedulePost
ActorMember --> UC_PublishNow
ActorMember --> UC_ViewHistory
ActorMember --> UC_ConnectSocial

ActorOwner --> UC_ManageMembers
ActorOwner --> UC_ConnectSocial
ActorOwner --> UC_ViewHistory

ActorAdmin --> UC_ManagePricing
ActorAdmin --> UC_ViewAnalytics

note right of UC_SchedulePost
  Hỗ trợ 2 chiến lược:
  - Interval (Mỗi X phút)
  - Specific Times (Khung giờ cố định)
end note

note right of UC_ConnectSocial
  Hỗ trợ:
  - YouTube
  - Facebook/Instagram
  - TikTok (gồm webhook)
end note

@enduml
