@startuml UseCase_Media_Library
title Use Case: Media Library Management - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false


actor "Thành viên Brand" as ActorMember
actor "Cloudinary Service (External)" as ActorCloudinary

rectangle "Media Library Scope" {
    usecase "Xem thư viện đa phương tiện" as UC_ViewLibrary
    usecase "Tìm kiếm & Lọc Media" as UC_SearchMedia
    
    usecase "Tải lên tệp Media mới" as UC_UploadMedia
    usecase "Lấy chữ ký bảo mật (Signature)" as UC_GetSignature
    usecase "Lưu Metadata vào hệ thống" as UC_SaveMetadata
    
    usecase "Xóa tệp Media" as UC_DeleteMedia
    usecase "Xóa tệp vật lý trên Cloud" as UC_CloudDelete
}

' Thành viên Brand tương tác
ActorMember --> UC_ViewLibrary
ActorMember --> UC_UploadMedia
ActorMember --> UC_DeleteMedia

' Tra cứu Media
UC_ViewLibrary <.. UC_SearchMedia : <<extend>>

' Luồng tải lên Media
UC_UploadMedia ..> UC_GetSignature : <<include>>
UC_UploadMedia ..> UC_SaveMetadata : <<include>>
UC_UploadMedia --> ActorCloudinary : Direct Upload

' Luồng xóa Media
UC_DeleteMedia ..> UC_CloudDelete : <<include>>
UC_CloudDelete --> ActorCloudinary : Xóa file

@enduml
