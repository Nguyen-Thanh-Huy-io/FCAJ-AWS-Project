@startuml
left to right direction
skinparam packageStyle rectangle

actor "Brand Owner" as owner
actor "Payment Gateway" as stripe
actor "System" as sys

package "Phân hệ Admin & Billing" {
  usecase "Quản lý Gói cước / Thanh toán" as UC16
  usecase "Mở khóa giới hạn / Tạo Invoice" as UC16a
  usecase "Lưu vết hoạt động (Audit)" as UC17a
  usecase "Xem Nhật ký Hoạt động" as UC17b
}

owner --> UC16
UC16 ..> stripe : Giao dịch
stripe --> UC16a : Webhook Success
sys --> UC17a : Ghi log API
owner --> UC17b : Giám sát

@enduml
