@startuml UseCase_Admin_Pricing
title Use Case: Admin Administration & Pricing Strategy - PubliCast

left to right direction
skinparam monochrome true
skinparam shading false


actor "Quản trị viên (Admin)" as ActorAdmin
actor "Chủ Brand (Owner)" as ActorOwner

rectangle "Admin & Pricing Scope" {
    usecase "Quản lý tài khoản khách hàng" as UC_ManageUsers
    usecase "Khóa / Mở khóa tài khoản (Ban/Unban)" as UC_BanUser
    
    usecase "Cấu hình gói dịch vụ (Plans)" as UC_ConfigurePlans
    usecase "Quản lý bảng giá & Add-ons" as UC_ManagePricing
    
    usecase "Đăng ký mua gói cước" as UC_SubscribePlan
    usecase "Thanh toán hóa đơn" as UC_PayInvoice
    
    usecase "Xem báo cáo doanh thu tổng quan" as UC_ViewRevenue
    usecase "Theo dõi KPIs tăng trưởng (MRR/Churn Rate)" as UC_TrackKPIs
}

' Thao tác quản trị hệ thống
ActorAdmin --> UC_ManageUsers
UC_ManageUsers ..> UC_BanUser : <<include>>

ActorAdmin --> UC_ConfigurePlans
ActorAdmin --> UC_ManagePricing

ActorAdmin --> UC_ViewRevenue
UC_ViewRevenue ..> UC_TrackKPIs : <<include>>

' Thao tác của khách hàng B2B
ActorOwner --> UC_SubscribePlan
UC_SubscribePlan ..> UC_PayInvoice : <<include>>

@enduml
