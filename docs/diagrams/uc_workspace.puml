@startuml
left to right direction
skinparam packageStyle rectangle

actor "Brand Owner/Manager" as admin
actor "Invitee" as invitee

package "Phân hệ Workspace & Roles" {
  usecase "Quản lý Đội ngũ (Mời/Xóa)" as UC04
  usecase "Chấp nhận lời mời" as UC04a
  usecase "Cấu hình Phân quyền tùy chỉnh (Custom Roles)" as UC05
}

admin --> UC04
admin --> UC05
invitee --> UC04a

UC04 ..> UC04a : <<initiates>>

