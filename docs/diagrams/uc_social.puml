@startuml
left to right direction
skinparam packageStyle rectangle

actor "Brand Admin" as admin
actor "Customer Support" as support
actor "Social APIs" as api

package "Phân hệ Social & Inbox" {
  usecase "Kết nối Nền tảng (OAuth)" as UC11
  usecase "Gom tin nhắn/bình luận (Webhook)" as UC12a
  usecase "Quản lý & Phản hồi Hòm thư (Unified Inbox)" as UC12b
}

admin --> UC11
UC11 ..> api : OAuth 2.0

api --> UC12a : Push Events
UC12a --> UC12b : Lưu vào DB
support --> UC12b
UC12b ..> api : Send Reply

@enduml
