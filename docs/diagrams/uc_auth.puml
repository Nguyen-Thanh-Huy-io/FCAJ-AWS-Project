@startuml
left to right direction
skinparam packageStyle rectangle

actor "Guest/User" as user

package "Phân hệ Auth & Core" {
  usecase "Đăng nhập / Đăng ký (Local & Social)" as UC01
  usecase "Quản lý Hồ sơ & Cài đặt" as UC02
  usecase "Tạo/Quản lý Brand" as UC03
}

user --> UC01
user --> UC02
user --> UC03

note right of UC01
  Gồm Email/OTP và 
  OAuth (Google/Facebook/IG)
end note

@enduml
