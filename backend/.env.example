# ============================================================
# PubliCast Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL via Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set to 'true' to use in-memory Redis fallback (development/test only)
USE_MEMORY_REDIS=false

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Resend configuration (for local/dev only; in ECS/Secret Manager these are injected via environment variables)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# JWT Configuration (use strong random secrets — min 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_ACCESS_SECRET_MIN_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_MIN_32_CHARS

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:5173
# Comma-separated list of production origins (e.g. https://app.example.com)
CORS_ALLOWED_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Backend Base URL (for OAuth redirect URIs, ngrok in dev)
BACKEND_BASE_URL=http://localhost:3000

# AWS S3 (Media Storage)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=your-bucket-name
# Optional: static credentials (use IAM Role on ECS instead)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront domain for CDN URL
# CLOUDFRONT_DOMAIN=d123abc.cloudfront.net

# Upload storage mode: 'local' for disk storage, omit for S3
# UPLOAD_STORAGE=local

# Discord OAuth & Bot Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# System Constants
SOCIAL_SYNC_COOLDOWN_HOURS=2

# =============================================
# PAYMENT & BILLING
# =============================================
PAYMENT_GATEWAY="vietqr"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
VIETQR_ACQ_ID="970422"
VIETQR_TEMPLATE="compact2"
SEPAY_API_KEY=""
PAYMENT_QR_EXPIRY_MINUTES=15
